# Taxline site build settings. All optional: with nothing set, the site builds
# fully offline (the mock adapters), which is what GitHub Pages serves.
# Copy to site/.env to use. Only PUBLIC_* values reach the browser, so never put
# a secret here.

# "mock" (default) keeps both seams offline. "cloudflare" sends the contact form
# to PUBLIC_CONTACT_ENDPOINT; any value other than "mock" sends the product
# console to PUBLIC_SERVICE_ENDPOINT.
PUBLIC_API_ADAPTER=mock

# The agent service (npm run dev:service), e.g. http://localhost:8787
PUBLIC_SERVICE_ENDPOINT=

# The contact Worker URL (workers/contact, after wrangler deploy).
PUBLIC_CONTACT_ENDPOINT=

# SITE_URL and BASE_PATH are read by astro.config.mjs from the shell, not from
# this file: BASE_PATH=/taxline npm run build

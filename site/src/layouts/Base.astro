---
import '@fontsource/ibm-plex-sans/400.css';
import '@fontsource/ibm-plex-sans/500.css';
import '@fontsource/ibm-plex-sans/600.css';
import '@fontsource/ibm-plex-sans/700.css';
import '@fontsource/ibm-plex-mono/400.css';
import '@fontsource/ibm-plex-mono/500.css';
import '@fontsource/ibm-plex-mono/600.css';
import '../styles/global.css';
import { absolute, u } from '../lib/url';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'Taxline — agentic tax operations',
  description = 'Remove manual tax operations. Keep the human approval. A fleet of specialized AI agents triages, extracts, researches, and assembles tax work — with confidence scores and citations on every field.',
} = Astro.props;

---

<!doctype html>
<html lang="en" class="scroll-smooth">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="color-scheme" content="dark" />
    <meta name="theme-color" content="#0e0f10" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    {/* Absolute, because a crawler resolves og:image against nothing. */}
    <meta property="og:image" content={absolute('social-preview.png', Astro.site)} />
    <meta property="og:image:width" content="1280" />
    <meta property="og:image:height" content="640" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={absolute('social-preview.png', Astro.site)} />
    <link rel="icon" href={u('favicon.svg')} type="image/svg+xml" />
  </head>
  <body class="min-h-screen bg-base text-fg antialiased">
    <slot />
    <script>
      // Scroll-reveal: rise + fade elements tagged [data-reveal] as they enter view.
      const io = new IntersectionObserver(
        (entries) => {
          for (const e of entries) {
            if (e.isIntersecting) {
              e.target.classList.add('revealed');
              io.unobserve(e.target);
            }
          }
        },
        { rootMargin: '0px 0px -8% 0px', threshold: 0.05 },
      );
      document.querySelectorAll('[data-reveal]').forEach((el) => io.observe(el));
    </script>
  </body>
</html>

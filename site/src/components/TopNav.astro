---
import Logo from './Logo.astro';
import Button from './Button.astro';
import MegaMenu from './MegaMenu.astro';
import { Icon } from 'astro-icon/components';
import { u } from '../lib/url';

---

<header class="sticky top-0 z-50 border-b border-border bg-base">
  <div class="mx-auto flex h-[60px] max-w-[1200px] items-center justify-between px-5 sm:px-6">
    <div class="flex items-center gap-3">
      <button
        type="button"
        aria-label="Open product menu"
        aria-expanded="false"
        aria-controls="megamenu"
        data-megamenu-trigger
        class="grid size-9 place-items-center rounded-md text-fg-muted transition-colors hover:bg-raised hover:text-fg"
      >
        <Icon name="lucide:menu" class="size-5" />
      </button>
      <a href={u('')} class="flex items-center" aria-label="Taxline home"><Logo /></a>
    </div>
    <nav class="flex items-center gap-2 sm:gap-3" aria-label="Primary">
      <a href={u('product')} class="hidden rounded-md px-2 py-1 text-sm text-fg-muted transition-colors hover:text-fg md:inline">Product</a>
      <a href={u('tools')} class="hidden rounded-md px-2 py-1 text-sm text-fg-muted transition-colors hover:text-fg md:inline">Free tools</a>
      <a href={u('insights')} class="hidden rounded-md px-2 py-1 text-sm text-fg-muted transition-colors hover:text-fg lg:inline">Insights</a>
      <a href={u('pricing')} class="hidden rounded-md px-2 py-1 text-sm text-fg-muted transition-colors hover:text-fg md:inline">Pricing</a>
      <span class="hidden h-4 w-px bg-border md:inline-block" aria-hidden="true"></span>
      <a href={u('app')} class="hidden rounded-md px-2 py-1 text-sm text-fg-muted transition-colors hover:text-fg sm:inline">Sign in</a>
      <Button href={u('contact')} size="sm">Book a demo</Button>
    </nav>
  </div>
  <MegaMenu />
</header>

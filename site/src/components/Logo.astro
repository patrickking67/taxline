---
interface Props {
  wordmark?: boolean;
  size?: number;
  class?: string;
}
const { wordmark = true, size = 28, class: cls = '' } = Astro.props;
---

<span class:list={['inline-flex items-center gap-2.5', cls]}>
  <svg width={size} height={size} viewBox="0 0 48 48" fill="none" xmlns="http://www.w3.org/2000/svg" role="img" aria-label="Taxline" class="shrink-0">
    <rect x="0.5" y="0.5" width="47" height="47" rx="8" fill="#16181a" stroke="#3a3f42"></rect>
    <rect x="12" y="15" width="24" height="2.4" rx="1.2" fill="#6e6b65"></rect>
    <rect x="12" y="22.8" width="18" height="2.4" rx="1.2" fill="#a6a29a"></rect>
    <rect x="12" y="30.6" width="24" height="3" rx="1.5" fill="#3da57b"></rect>
  </svg>
  {wordmark && <span class="text-[19px] font-semibold tracking-[-0.01em] text-fg">Taxline</span>}
</span>

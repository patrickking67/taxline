---
import { Icon } from 'astro-icon/components';
interface Props { icon?: string; class?: string; }
const { icon = 'lucide:file-text', class: cls = '' } = Astro.props;
---

<span class:list={['inline-flex items-center gap-[7px] rounded-sm border border-border bg-panel px-2.5 py-[5px] font-mono text-[11px] text-fg-muted', cls]}>
  <Icon name={icon} class="size-[13px] shrink-0 text-info" />
  <span class="truncate"><slot /></span>
</span>

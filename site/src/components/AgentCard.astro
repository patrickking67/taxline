---
import { Icon } from 'astro-icon/components';
interface Props {
  icon: string;
  name: string;
  title: string;
  body: string;
  tools?: string[];
  href?: string;
  class?: string;
}
const { icon, name, title, body, tools = [], href, class: cls = '' } = Astro.props;
const Tag = href ? 'a' : 'div';
---

<Tag href={href} class:list={['block rounded-lg border border-border bg-panel p-5 shadow-1 transition-colors', href && 'hover:border-border-strong', cls]}>
  <div class="flex items-center justify-between">
    <span class="ds-eyebrow">{name}</span>
    <div class="grid size-8 place-items-center rounded-md border border-border bg-raised">
      <Icon name={icon} class="size-4 text-fg-muted" />
    </div>
  </div>
  <h3 class="mt-3.5 text-[17px] font-semibold text-fg">{title}</h3>
  <p class="mt-1.5 text-[13px] leading-relaxed text-fg-muted">{body}</p>
  {tools.length > 0 && (
    <div class="mt-4 flex flex-wrap gap-1.5 border-t border-border-faint pt-3">
      {tools.map((t) => <span class="rounded-sm bg-raised px-2 py-0.5 font-mono text-[10px] text-fg-muted">{t}</span>)}
    </div>
  )}
</Tag>

---
interface Props { legend: string; class?: string }
const { legend, class: cls = '' } = Astro.props;
---

<fieldset class:list={['min-w-0 rounded-lg border border-border bg-panel p-4', cls]}>
  <legend class="px-1.5 font-mono text-[11px] font-medium uppercase tracking-[0.14em] text-fg-faint">{legend}</legend>
  <div class="grid gap-3 sm:grid-cols-2"><slot /></div>
</fieldset>

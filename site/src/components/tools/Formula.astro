---
// A typeset formula. The slot holds MathML (rendered natively by every current
// browser); `plain` is the same formula as text for copy and assistive tech.
interface Props { title: string; plain: string; note?: string }
const { title, plain, note } = Astro.props;
---

<figure class="min-w-0 rounded-lg border border-border bg-panel p-5">
  <figcaption class="font-mono text-[11px] font-medium uppercase tracking-[0.14em] text-fg-faint">{title}</figcaption>
  <div class="formula mt-4 overflow-x-auto text-fg" aria-label={plain}><slot /></div>
  {note && <p class="mt-4 border-t border-border-faint pt-3 text-[12px] leading-relaxed text-fg-muted">{note}</p>}
</figure>

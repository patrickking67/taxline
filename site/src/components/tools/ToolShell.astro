---
// Page frame for every calculator: breadcrumb, hero, the calculator itself,
// formulas, scope limits, FAQ (with FAQPage schema), related tools, and the CTA.
import Base from '../../layouts/Base.astro';
import TopNav from '../TopNav.astro';
import Footer from '../Footer.astro';
import Button from '../Button.astro';
import { Icon } from 'astro-icon/components';
import { tools } from '../../lib/data/tools';
import { breadcrumbs, calculator, faqPage } from '../../lib/seo';
import { u } from '../../lib/url';

interface Props {
  slug: string;
  title: string;
  description: string;
  h1: string;
  lead: string;
  faqs: { q: string; a: string }[];
  limits: string[];
}
const { slug, title, description, h1, lead, faqs, limits } = Astro.props;
const meta = tools.find((t) => t.slug === slug)!;
const related = tools.filter((t) => t.slug !== slug);
const schema = [
  calculator(Astro.site, { name: meta.name, path: `tools/${slug}/`, description }),
  breadcrumbs(Astro.site, [
    { name: 'Home', path: '' },
    { name: 'Tools', path: 'tools/' },
    { name: meta.name, path: `tools/${slug}/` },
  ]),
  faqPage(faqs),
];
---

<Base title={title} description={description} schema={schema}>
  <TopNav />
  <main id="main">
    <section class="relative overflow-hidden border-b border-border">
      <div class="pointer-events-none absolute inset-0 console-grid opacity-50"></div>
      <div class="relative mx-auto max-w-[1200px] px-5 pb-10 pt-12 sm:px-6">
        <nav aria-label="Breadcrumb" class="font-mono text-[11px] text-fg-faint">
          <ol class="flex flex-wrap items-center gap-1.5">
            <li><a href={u('')} class="hover:text-fg">Taxline</a></li>
            <li aria-hidden="true">/</li>
            <li><a href={u('tools')} class="hover:text-fg">Tools</a></li>
            <li aria-hidden="true">/</li>
            <li aria-current="page" class="text-fg-muted">{meta.short}</li>
          </ol>
        </nav>
        <div class="mt-6 flex flex-wrap items-center gap-2">
          <span class="ds-eyebrow">Free calculator</span>
          <span class="rounded-sm border border-border bg-panel px-2 py-0.5 font-mono text-[10px] text-fg-muted">TY2026 · Rev. Proc. 2025-32</span>
          <span class="rounded-sm border border-border bg-panel px-2 py-0.5 font-mono text-[10px] text-fg-muted">calculations run in your browser</span>
        </div>
        <h1 class="ds-h1 mt-4 max-w-3xl">{h1}</h1>
        <p class="ds-lead mt-4 max-w-2xl">{lead}</p>
      </div>
    </section>

    <section class="border-b border-border">
      <div class="mx-auto max-w-[1200px] px-5 py-10 sm:px-6">
        <slot />
      </div>
    </section>

    {Astro.slots.has('formulas') && (
      <section class="border-b border-border bg-panel/30">
        <div class="mx-auto max-w-[1200px] px-5 py-16 sm:px-6">
          <p class="ds-eyebrow">The math</p>
          <h2 class="ds-h2 mt-3 max-w-2xl">Every number, as a formula.</h2>
          <p class="ds-lead mt-3 max-w-2xl">The engine is pure functions with hand-worked unit tests. These are the equations it runs — the workpaper above shows them with your operands filled in.</p>
          <div class="mt-8 grid gap-4 lg:grid-cols-2"><slot name="formulas" /></div>
        </div>
      </section>
    )}

    <section class="border-b border-border">
      <div class="mx-auto grid max-w-[1200px] gap-10 px-5 py-16 sm:px-6 lg:grid-cols-[1fr_340px]">
        <div>
          <p class="ds-eyebrow">Questions</p>
          <h2 class="ds-h2 mt-3">What this calculator answers.</h2>
          <div class="mt-8 grid gap-3">
            {faqs.map((f) => (
              <details class="group rounded-lg border border-border bg-panel px-5 open:border-border-strong">
                <summary class="flex cursor-pointer list-none items-center justify-between gap-4 py-4 text-[15px] font-medium text-fg [&::-webkit-details-marker]:hidden">
                  <h3>{f.q}</h3>
                  <Icon name="lucide:plus" class="size-4 shrink-0 text-fg-faint transition-transform duration-150 group-open:rotate-45" />
                </summary>
                <p class="border-t border-border-faint pb-4 pt-4 text-sm leading-relaxed text-fg-muted">{f.a}</p>
              </details>
            ))}
          </div>
        </div>
        <aside>
          <div class="rounded-lg border border-border bg-panel p-5">
            <p class="font-mono text-[11px] font-medium uppercase tracking-[0.14em] text-warn-bright">Scope · not modeled</p>
            <ul class="mt-3 space-y-2">
              {limits.map((l) => (
                <li class="flex items-start gap-2 text-[13px] leading-relaxed text-fg-muted">
                  <Icon name="lucide:minus" class="mt-1 size-3.5 shrink-0 text-fg-faint" />{l}
                </li>
              ))}
            </ul>
            <p class="mt-4 border-t border-border-faint pt-3 text-[12px] leading-relaxed text-fg-faint">An estimate for planning and review. Not tax advice and not a filed return. A preparer signs off before anything ships.</p>
          </div>
          <div class="mt-4 rounded-lg border border-border bg-panel p-5">
            <p class="font-mono text-[11px] font-medium uppercase tracking-[0.14em] text-fg-faint">More calculators</p>
            <ul class="mt-3 space-y-1">
              {related.map((t) => (
                <li>
                  <a href={u(`tools/${t.slug}`)} class="group flex items-center gap-2.5 rounded-md px-2 py-1.5 text-[13px] text-fg-muted hover:bg-raised hover:text-fg">
                    <Icon name={t.icon} class="size-4 text-fg-faint group-hover:text-accent" />{t.name}
                  </a>
                </li>
              ))}
            </ul>
          </div>
        </aside>
      </div>
    </section>

    <section class="border-b border-border">
      <div class="mx-auto flex max-w-[1200px] flex-col items-start justify-between gap-6 px-5 py-14 sm:flex-row sm:items-center sm:px-6">
        <div>
          <h2 class="ds-h2 max-w-xl">The same engine runs inside the fleet.</h2>
          <p class="ds-small mt-2 max-w-xl">Ledger calls it through <code class="font-mono text-fg">compute_tax</code> for every workpaper figure. The model never does the arithmetic.</p>
        </div>
        <div class="flex gap-3">
          <Button href={u('app')}>See it run</Button>
          <Button href={u('methodology')} variant="ghost">Methodology</Button>
        </div>
      </div>
    </section>
  </main>
  <Footer />
</Base>

---
import { Icon } from 'astro-icon/components';
const base = import.meta.env.BASE_URL;
const u = (p = '') => (base + p).replace(/\/{2,}/g, '/');

const products = [
  { icon: 'lucide:bot', name: 'AI Tax Co-Pilot', desc: 'Ask the fleet across a client file.', href: 'product' },
  { icon: 'lucide:git-branch', name: 'Agent Workforce', desc: 'Five agents, one orchestrator.', href: 'agents' },
  { icon: 'lucide:search', name: 'Tax Research', desc: 'Citation-backed answers.', href: 'docs' },
  { icon: 'lucide:file-check', name: 'Tax Prep Support', desc: 'Draft returns, sourced.', href: 'product' },
  { icon: 'lucide:line-chart', name: 'Client Intelligence', desc: 'Signals across your book.', href: 'product' },
  { icon: 'lucide:file-stack', name: 'Workpaper Builder', desc: 'Reviewer-ready output.', href: 'product' },
  { icon: 'lucide:calendar-clock', name: 'Compliance Calendar', desc: 'Deadlines, tracked.', href: 'product' },
  { icon: 'lucide:table', name: 'Tax Matrix', desc: 'Clients × forms × status.', href: 'product' },
];

const audiences = [
  { key: 'firms', label: 'Tax & accounting firms', line: 'Reduce review drag across every return. Reviewer-ready workpapers, multi-client compliance.' },
  { key: 'businesses', label: 'Businesses', line: 'Keep books-to-return tight. Extraction from statements, deadlines across entities.' },
  { key: 'solo', label: 'Solo operators', line: 'Do more returns without more hours. Intake, extraction, drafting — you approve.' },
];
---

<div id="megamenu" hidden class="absolute left-0 right-0 top-full border-b border-border bg-panel shadow-pop">
  <div class="mx-auto max-w-[1200px] px-5 py-7 sm:px-6">
    <div class="grid gap-8 lg:grid-cols-[260px_1fr]">
      <!-- audience tabs -->
      <div class="lg:border-r lg:border-border lg:pr-8">
        <p class="ds-eyebrow text-fg-faint">For</p>
        <div class="mt-3 flex flex-col gap-1">
          {audiences.map((a, i) => (
            <button type="button" data-aud={a.key} class:list={['aud-tab rounded-md px-3 py-2 text-left text-sm transition-colors', i === 0 ? 'bg-accent-soft text-fg' : 'text-fg-muted hover:bg-raised hover:text-fg']}>{a.label}</button>
          ))}
        </div>
        <div class="mt-4 min-h-[3rem] px-3">
          {audiences.map((a, i) => (
            <p data-aud-pane={a.key} hidden={i !== 0} class="text-[13px] leading-relaxed text-fg-muted">{a.line}</p>
          ))}
        </div>
        <a href={u('solutions')} class="mt-2 inline-flex items-center gap-1.5 px-3 text-sm font-medium text-accent hover:text-accent-hover">See solutions <Icon name="lucide:arrow-right" class="size-4" /></a>
      </div>

      <!-- product grid -->
      <div>
        <p class="ds-eyebrow text-fg-faint">Product</p>
        <div class="mt-3 grid gap-1 sm:grid-cols-2">
          {products.map((p) => (
            <a href={u(p.href)} class="group flex items-start gap-3 rounded-md px-3 py-2.5 transition-colors hover:bg-raised">
              <div class="mt-0.5 grid size-8 shrink-0 place-items-center rounded-md border border-border bg-base"><Icon name={p.icon} class="size-4 text-fg-muted group-hover:text-accent" /></div>
              <div>
                <div class="text-[13px] font-semibold text-fg">{p.name}</div>
                <div class="text-[12px] text-fg-faint">{p.desc}</div>
              </div>
            </a>
          ))}
        </div>
        <div class="mt-5 flex flex-wrap gap-x-6 gap-y-2 border-t border-border-faint pt-4 text-sm">
          <a href={u('app')} class="inline-flex items-center gap-1.5 text-fg-muted hover:text-fg"><Icon name="lucide:layout-dashboard" class="size-4 text-fg-faint" />Open the app</a>
          <a href={u('docs')} class="inline-flex items-center gap-1.5 text-fg-muted hover:text-fg"><Icon name="lucide:book-open" class="size-4 text-fg-faint" />Read the docs</a>
          <a href={u('pricing')} class="inline-flex items-center gap-1.5 text-fg-muted hover:text-fg"><Icon name="lucide:tag" class="size-4 text-fg-faint" />Pricing</a>
        </div>
      </div>
    </div>
  </div>
</div>

<script>
  const trigger = document.querySelector<HTMLButtonElement>('[data-megamenu-trigger]');
  const menu = document.getElementById('megamenu');
  if (trigger && menu) {
    const open = () => { menu.hidden = false; trigger.setAttribute('aria-expanded', 'true'); };
    const close = () => { menu.hidden = true; trigger.setAttribute('aria-expanded', 'false'); };
    trigger.addEventListener('click', (e) => { e.stopPropagation(); menu.hidden ? open() : close(); });
    document.addEventListener('click', (e) => {
      if (!menu.hidden && !menu.contains(e.target as Node) && !trigger.contains(e.target as Node)) close();
    });
    document.addEventListener('keydown', (e) => { if (e.key === 'Escape') close(); });

    const tabs = Array.from(menu.querySelectorAll<HTMLButtonElement>('.aud-tab'));
    const panes = Array.from(menu.querySelectorAll<HTMLElement>('[data-aud-pane]'));
    for (const t of tabs) {
      t.addEventListener('click', () => {
        const key = t.dataset.aud;
        for (const x of tabs) {
          const on = x === t;
          x.classList.toggle('bg-accent-soft', on);
          x.classList.toggle('text-fg', on);
          x.classList.toggle('text-fg-muted', !on);
        }
        for (const p of panes) p.hidden = p.dataset.audPane !== key;
      });
    }
  }
</script>

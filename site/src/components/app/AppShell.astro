---
import Base from '../../layouts/Base.astro';
import Logo from '../Logo.astro';
import Button from '../Button.astro';
import { Icon } from 'astro-icon/components';
import { sidebarNav } from '../../lib/data/app';

interface Props {
  title?: string;
  active?: string;
  breadcrumb?: { label: string; href?: string }[];
}
const { title = '', active = 'app', breadcrumb } = Astro.props;
const base = import.meta.env.BASE_URL;
const u = (p = '') => (base + p).replace(/\/{2,}/g, '/');
---

<Base title={`${title} · Taxline`}>
  <div class="flex min-h-screen">
    <!-- sidebar -->
    <aside class="hidden w-64 shrink-0 flex-col border-r border-border bg-base md:flex">
      <div class="flex h-[60px] items-center border-b border-border px-5"><Logo /></div>
      <nav class="flex-1 space-y-1 p-3">
        {sidebarNav.map((item) => (
          <a
            href={u(item.href)}
            class:list={['flex items-center gap-3 rounded-md px-3 py-2 text-sm transition-colors', active === item.href ? 'bg-accent-soft text-fg' : 'text-fg-muted hover:bg-raised hover:text-fg']}
          >
            <Icon name={item.icon} class:list={['size-[18px]', active === item.href ? 'text-accent' : 'text-fg-faint']} />
            <span class="flex-1">{item.label}</span>
            {item.badge && (
              <span class:list={['rounded-sm px-1.5 py-0.5 font-mono text-[11px]', active === item.href ? 'bg-accent-soft text-accent' : 'bg-raised text-fg-muted']}>{item.badge}</span>
            )}
          </a>
        ))}
      </nav>
      <div class="space-y-1 border-t border-border p-3">
        <div class="flex items-center gap-2 px-3 py-2 font-mono text-xs text-fg-muted">
          <span class="size-1.5 rounded-full bg-accent dot-pulse"></span>Fleet running
        </div>
        <a href={u('app')} class="flex items-center gap-3 rounded-md px-3 py-2 text-sm text-fg-muted transition-colors hover:bg-raised hover:text-fg">
          <Icon name="lucide:settings" class="size-[18px] text-fg-faint" />Settings
        </a>
      </div>
    </aside>

    <!-- main -->
    <div class="flex min-w-0 flex-1 flex-col">
      <header class="flex h-[60px] shrink-0 items-center gap-4 border-b border-border px-5">
        <a href={u('app')} class="grid size-9 place-items-center rounded-md text-fg-muted hover:bg-raised md:hidden"><Icon name="lucide:menu" class="size-5" /></a>
        {breadcrumb ? (
          <nav class="flex min-w-0 items-center gap-2 truncate font-mono text-[13px]">
            {breadcrumb.map((b, i) => (
              <>
                {i > 0 && <span class="text-fg-faint">·</span>}
                {b.href ? <a href={u(b.href)} class="text-fg-muted hover:text-fg">{b.label}</a> : <span class="truncate text-fg">{b.label}</span>}
              </>
            ))}
          </nav>
        ) : (
          <h1 class="text-[15px] font-semibold text-fg">{title}</h1>
        )}
        <div class="ml-auto flex items-center gap-2.5">
          <label class="hidden items-center gap-2 rounded-md border border-border bg-raised px-3 py-1.5 lg:flex">
            <Icon name="lucide:search" class="size-4 text-fg-faint" />
            <input placeholder="Search documents, clients, fields…" class="w-60 bg-transparent text-sm text-fg placeholder:text-fg-faint focus:outline-none" />
          </label>
          <button type="button" aria-label="Notifications" class="grid size-9 place-items-center rounded-md border border-border text-fg-muted transition-colors hover:bg-raised"><Icon name="lucide:bell" class="size-[18px]" /></button>
          <Button size="sm"><Icon name="lucide:upload" class="size-4" />Upload</Button>
          <span class="grid size-8 place-items-center rounded-md border border-border bg-raised font-mono text-xs text-fg-muted">PK</span>
        </div>
      </header>
      <main class="flex-1 overflow-auto"><slot /></main>
    </div>
  </div>
</Base>

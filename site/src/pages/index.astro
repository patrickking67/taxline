---
import Base from '../layouts/Base.astro';
import TopNav from '../components/TopNav.astro';
import Footer from '../components/Footer.astro';
import Button from '../components/Button.astro';
import ConsoleHero from '../components/ConsoleHero.astro';
import FleetOrbit from '../components/FleetOrbit.astro';
import FeatureShowcase from '../components/FeatureShowcase.astro';
import AgentCard from '../components/AgentCard.astro';
import { Icon } from 'astro-icon/components';
import { fleet } from '../lib/data/fleet';
import { u } from '../lib/url';
import { tools } from '../lib/data/tools';
import { softwareApp } from '../lib/seo';
import { computeReturn, fmtUsd } from '@taxline/tax-engine';
// Drawn by `python -m taxline_quant report` (npm run report); never edited by hand.
import ratesChart from '../../../docs/quant/rates-dark.svg';
import ratesChartLight from '../../../docs/quant/rates-light.svg';

const REPO = 'https://github.com/patrickking67/taxline';
// Each figure is enforced by a test: python/tests/test_parity.py and its fixtures.
const quantProof = [
  {
    n: '47',
    t: 'named edge cases',
    d: 'Bracket floors, the $400 floors, the wage base, QBI phase-in.',
  },
  {
    n: '5,000',
    t: 'seeded random cases',
    d: 'Half carry cents, where a float engine and an exact one part ways.',
  },
  { n: '1¢', t: 'tolerance', d: 'Any difference in a money line fails the build.' },
];

// A real engine run, computed at build time — the home page shows output, not a mock.
const sample = computeReturn({
  status: 'mfj',
  wages: 142_000,
  selfEmploymentProfit: 38_000,
  qualifiedDividends: 4_000,
  ordinaryDividends: 4_000,
  children: 2,
  federalWithholding: 16_500,
});
const sampleLines = sample.lines.filter((l) =>
  ['agi', 'deduction', 'qbi', 'taxable', 'tax', 'ctc', 'setax', 'totaltax', 'balance'].includes(
    l.id,
  ),
);

const trust = [
  ['lucide:shield-check', 'SOC 2 in progress'],
  ['lucide:lock', 'No training on your data'],
  ['lucide:quote', 'Citation-backed'],
  ['lucide:user-check', 'Human-approved'],
];

const audiences = [
  ['lucide:building-2', 'Tax & accounting firms'],
  ['lucide:briefcase', 'Finance teams'],
  ['lucide:user', 'Solo operators'],
];

const steps = [
  {
    n: '01',
    icon: 'lucide:inbox',
    t: 'Intake',
    d: 'Drop documents. Relay classifies and queues them.',
  },
  {
    n: '02',
    icon: 'lucide:scan-line',
    t: 'Extract',
    d: 'Lens scores and cites every field. Nothing assumed.',
  },
  { n: '03', icon: 'lucide:search', t: 'Research', d: 'Atlas answers from primary sources.' },
  {
    n: '04',
    icon: 'lucide:file-stack',
    t: 'Assemble',
    d: 'Ledger builds reviewer-ready workpapers.',
  },
  { n: '05', icon: 'lucide:user-check', t: 'Review', d: 'You approve. Nothing ships unreviewed.' },
];
---

<Base
  title="Taxline: AI tax operations with a tested engine and human approval"
  description="Five AI agents move tax work from intake to reviewer-ready workpapers. Every field carries a confidence score and a citation, a tested 2026 engine does the math, and a person approves before anything ships."
  schema={[softwareApp(Astro.site)]}
>
  <TopNav />
  <main id="main">
    <!-- Hero -->
    <section class="relative overflow-hidden border-b border-border">
      <div class="pointer-events-none absolute inset-0 console-grid opacity-60"></div>
      <div class="relative mx-auto grid max-w-[1200px] items-center gap-12 px-5 pb-14 pt-20 sm:px-6 lg:grid-cols-2">
        <div>
          <p class="ds-eyebrow reveal">Agentic tax operations</p>
          <h1 class="ds-display reveal mt-4" style="animation-delay:.05s">
            Remove manual tax operations.
            <br class="hidden sm:block" /> Keep the human approval.
          </h1>
          <p class="ds-lead reveal mt-5 max-w-xl" style="animation-delay:.1s">
            A coordinated agent fleet — Relay, Lens, Atlas, Ledger, and Sentry — turns a pile of
            documents into reviewer-ready workpapers. A confidence score and a citation on every
            field. You approve. Nothing ships unreviewed.
          </p>
          <div class="reveal mt-8 flex flex-wrap gap-3" style="animation-delay:.15s">
            <Button href={u('contact')}>Book a demo</Button>
            <Button href={u('app')} variant="ghost">
              See it run
            </Button>
          </div>
          <p class="reveal mt-4 font-mono text-xs text-fg-faint" style="animation-delay:.2s">
            Free Core plan · no credit card
          </p>
          <div class="reveal mt-7 flex flex-wrap gap-x-5 gap-y-2.5" style="animation-delay:.25s">
            {trust.map(([icon, label]) => (
              <span class="inline-flex items-center gap-2 text-[13px] text-fg-muted">
                <Icon name={icon} class="size-4 text-fg-faint" />
                {label}
              </span>
            ))}
          </div>
        </div>
        <div class="reveal" style="animation-delay:.15s">
          <FleetOrbit />
        </div>
      </div>
      <div class="relative border-t border-border-faint">
        <div class="mx-auto flex max-w-[1200px] flex-wrap items-center gap-x-8 gap-y-2 px-5 py-4 sm:px-6">
          <span class="font-mono text-[11px] uppercase tracking-[0.14em] text-fg-faint">
            Built for
          </span>
          {audiences.map(([icon, label]) => (
            <span class="inline-flex items-center gap-2 text-sm text-fg-muted">
              <Icon name={icon} class="size-4 text-fg-faint" />
              {label}
            </span>
          ))}
        </div>
      </div>
    </section>

    <!-- Live console -->
    <section class="border-b border-border">
      <div class="mx-auto max-w-[1200px] px-5 py-20 sm:px-6">
        <div class="flex items-end justify-between gap-6">
          <div>
            <p class="ds-eyebrow">The operating console</p>
            <h2 class="ds-h2 mt-3 max-w-2xl">Watch the fleet work — live, not a screenshot.</h2>
          </div>
          <a
            href={u('app')}
            class="hidden shrink-0 items-center gap-1.5 text-sm font-medium text-accent hover:text-accent-hover sm:inline-flex"
          >
            Open the app <Icon name="lucide:arrow-right" class="size-4" />
          </a>
        </div>
        <div class="mt-8">
          <ConsoleHero />
        </div>
      </div>
    </section>

    <!-- Feature showcase -->
    <section class="border-b border-border bg-panel/30">
      <div class="mx-auto max-w-[1200px] px-5 py-20 sm:px-6">
        <div>
          <p class="ds-eyebrow">Why Taxline</p>
          <h2 class="ds-h2 mt-3 max-w-2xl">Operations that move fast — and stay defensible.</h2>
          <p class="ds-lead mt-3 max-w-2xl">
            Speed where it's safe, a person where it matters. Every output is sourced, scored, and
            signed off.
          </p>
        </div>
        <div class="mt-10">
          <FeatureShowcase />
        </div>
      </div>
    </section>

    <!-- The fleet -->
    <section class="border-b border-border">
      <div class="mx-auto max-w-[1200px] px-5 py-20 sm:px-6">
        <div>
          <p class="ds-eyebrow">The fleet</p>
          <h2 class="ds-h2 mt-3 max-w-2xl">Five named agents. One orchestrator. Your approval.</h2>
          <p class="ds-lead mt-3 max-w-2xl">
            Each is a tool-using worker with a narrow job. Conductor routes between them and hands
            cited output to review.
          </p>
        </div>
        <div class="mt-10 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
          {fleet.map((a) => (
            <div>
              <AgentCard
                icon={a.icon}
                name={a.role}
                title={a.codename}
                body={a.blurb}
                tools={a.tools}
                href={u('agents')}
                class="lift h-full"
              />
            </div>
          ))}
          <a
            href={u('agents')}
            class="lift flex flex-col justify-between rounded-lg border border-dashed border-border bg-base p-5 hover:border-accent-line"
          >
            <span class="ds-eyebrow text-fg-faint">Conductor</span>
            <p class="mt-3 text-[13px] leading-relaxed text-fg-muted">
              The orchestrator. It picks the first agent, follows each handoff, collects every field
              and citation, and stops at the approval gate until a person signs off.
            </p>
            <span class="mt-4 inline-flex items-center gap-1.5 text-sm font-medium text-accent">
              See how routing works <Icon name="lucide:arrow-right" class="size-4" />
            </span>
          </a>
        </div>
      </div>
    </section>

    <!-- The math is code -->
    <section class="border-b border-border">
      <div class="mx-auto grid max-w-[1200px] items-start gap-12 px-5 py-20 sm:px-6 lg:grid-cols-[1fr_1.05fr]">
        <div>
          <p class="ds-eyebrow">The math is code</p>
          <h2 class="ds-h2 mt-3 max-w-xl">Models draft. A tested engine computes. You approve.</h2>
          <p class="ds-lead mt-3 max-w-xl">
            Ledger never does arithmetic in a prompt. It calls{' '}
            <code class="font-mono text-[16px] text-fg">compute_tax</code> — a deterministic engine
            with 2026 figures from Rev. Proc. 2025-32 — and quotes the trace: operands, form line,
            authority.
          </p>
          <ul class="mt-7 grid gap-2 sm:grid-cols-2">
            {tools.map((t) => (
              <li>
                <a
                  href={u(`tools/${t.slug}`)}
                  class="group flex items-center gap-2.5 rounded-md border border-border bg-panel px-3 py-2.5 text-[13px] text-fg-muted transition-colors hover:border-accent-line hover:text-fg"
                >
                  <Icon name={t.icon} class="size-4 text-fg-faint group-hover:text-accent" />
                  {t.name}
                </a>
              </li>
            ))}
          </ul>
          <a
            href={u('methodology')}
            class="mt-5 inline-flex items-center gap-1.5 text-sm font-medium text-accent hover:text-accent-hover"
          >
            How the engine is tested <Icon name="lucide:arrow-right" class="size-4" />
          </a>
        </div>
        <div class="rounded-md border border-paper-border bg-paper text-paper-ink shadow-2">
          <div class="flex items-center justify-between border-b border-paper-border px-5 py-3">
            <div>
              <div class="font-mono text-[10px] uppercase tracking-[0.14em] text-paper-ink-muted">
                compute_tax · return · TY2026
              </div>
              <div class="mt-0.5 text-[14px] font-semibold">
                Joint filers · W-2 + Schedule C · 2 children
              </div>
            </div>
            <span class="font-mono text-[11px] text-paper-ink-muted">WP-1040</span>
          </div>
          <table class="w-full border-collapse text-left">
            <tbody>
              {sampleLines.map((l) => (
                <tr
                  class:list={[
                    'border-t',
                    l.emphasis ? 'border-paper-border' : 'border-paper-border/50',
                  ]}
                >
                  <td class="w-[88px] whitespace-nowrap py-2 pl-5 pr-2 align-top font-mono text-[10px] text-paper-ink-muted">
                    {l.ref}
                  </td>
                  <td class="py-2 pr-2 align-top">
                    <div class:list={['text-[13px]', l.emphasis && 'font-semibold']}>{l.label}</div>
                    {l.formula && (
                      <div class="mt-0.5 font-mono text-[10px] text-paper-ink-muted">
                        {l.formula}
                      </div>
                    )}
                  </td>
                  <td
                    class:list={[
                      'whitespace-nowrap py-2 pr-5 text-right align-top font-mono text-[13px] tabular-nums',
                      l.emphasis && 'font-semibold',
                    ]}
                  >
                    {l.value < 0 ? `(${fmtUsd(-l.value)})` : fmtUsd(l.value)}
                  </td>
                </tr>
              ))}
            </tbody>
          </table>
          <p class="border-t border-paper-border px-5 py-2.5 font-mono text-[10px] text-paper-ink-muted">
            Computed at build time by @taxline/tax-engine · draft for reviewer sign-off
          </p>
        </div>
      </div>
    </section>

    <!-- The quantitative engine -->
    <section id="quant" class="border-b border-border bg-panel/30">
      <div class="mx-auto grid max-w-[1200px] items-start gap-12 px-5 py-20 sm:px-6 lg:grid-cols-[1fr_1.15fr]">
        <div>
          <p class="ds-eyebrow">Quantitative engine</p>
          <h2 class="ds-h2 mt-3 max-w-xl">A second engine checks the first.</h2>
          <p class="ds-lead mt-3 max-w-xl">
            The 2026 rules are written twice: in TypeScript for the product, and in Python on exact
            decimals for analysis. Every build runs both on the same cases and compares them line by
            line. The first run caught a half-cent rounding drift in the product engine, now fixed
            and tested.
          </p>
          <dl class="mt-7 grid gap-px overflow-hidden rounded-lg border border-border bg-border sm:grid-cols-3">
            {quantProof.map((q) => (
              <div class="bg-base p-4">
                <dt class="text-[13px] font-semibold text-fg">
                  <span class="block font-mono text-[22px] font-medium tabular-nums text-accent">
                    {q.n}
                  </span>
                  {q.t}
                </dt>
                <dd class="mt-1 text-[12px] leading-relaxed text-fg-muted">{q.d}</dd>
              </div>
            ))}
          </dl>
          <p class="mt-5 max-w-xl text-[13px] leading-relaxed text-fg-muted">
            The Python side also sweeps scenarios, projects estimated payments under income
            uncertainty with seeded Monte Carlo runs, and scores extraction confidence for
            calibration. Educational, on synthetic data; not tax advice.
          </p>
          <div class="mt-5 flex flex-wrap gap-x-6 gap-y-2 text-sm font-medium">
            <a
              href={`${REPO}/blob/main/docs/quant/report.md`}
              class="inline-flex items-center gap-1.5 text-accent hover:text-accent-hover"
            >
              Read the generated report <Icon name="lucide:arrow-up-right" class="size-4" />
            </a>
            <a
              href={`${REPO}/tree/main/python`}
              class="inline-flex items-center gap-1.5 text-accent hover:text-accent-hover"
            >
              Python source <Icon name="lucide:arrow-up-right" class="size-4" />
            </a>
          </div>
        </div>
        <figure class="overflow-hidden rounded-md border border-border bg-panel">
          {[
            { chart: ratesChart, only: 'only-dark' },
            { chart: ratesChartLight, only: 'only-light' },
          ].map(({ chart, only }) => (
            <img
              src={chart.src}
              width={chart.width}
              height={chart.height}
              decoding="async"
              class:list={[only, 'h-auto w-full align-bottom']}
              alt="Line chart for a single filer in tax year 2026. The effective rate on self-employment profit rises from about 14 percent to 33 percent at 400,000 dollars. The marginal rate steps between 14 and 32 percent, spikes above 60 percent between about 240,000 and 308,000 dollars while the business income deduction phases out, then settles at 38 percent."
            />
          ))}
          <figcaption class="border-t border-border px-4 py-3 font-mono text-[11px] leading-relaxed text-fg-faint">
            Marginal and effective rate on self-employment profit. Drawn by{' '}
            <span class="text-fg-muted">python -m taxline_quant report</span> from the model, not by
            hand.
          </figcaption>
        </figure>
      </div>
    </section>

    <!-- How it works -->
    <section class="border-b border-border">
      <div class="mx-auto max-w-[1200px] px-5 py-20 sm:px-6">
        <div>
          <p class="ds-eyebrow">Intake to reviewer-ready</p>
          <h2 class="ds-h2 mt-3 max-w-2xl">
            From a dropped document to a workpaper you sign off on.
          </h2>
        </div>
        <div class="mt-12 grid gap-px overflow-hidden rounded-lg border border-border bg-border sm:grid-cols-2 lg:grid-cols-5">
          {steps.map((s) => (
            <div class="flex flex-col gap-3 bg-base p-5">
              <div class="flex items-center justify-between">
                <Icon name={s.icon} class="size-5 text-accent" />
                <span class="font-mono text-[11px] tabular-nums text-fg-faint">{s.n}</span>
              </div>
              <div>
                <div class="text-[15px] font-semibold text-fg">{s.t}</div>
                <p class="mt-1 text-[13px] leading-relaxed text-fg-muted">{s.d}</p>
              </div>
            </div>
          ))}
        </div>
        <p class="mt-6 inline-flex items-center gap-2 font-mono text-xs text-fg-faint">
          <Icon name="lucide:user-check" class="size-4 text-accent" />A human approves before output
          ships — every time.
        </p>
      </div>
    </section>

    <!-- CTA -->
    <section class="border-b border-border">
      <div class="mx-auto flex max-w-[1200px] flex-col items-start justify-between gap-6 px-5 py-16 sm:flex-row sm:items-center sm:px-6">
        <div>
          <h2 class="ds-h2 max-w-xl">Reduce review drag. Ship reviewer-ready output.</h2>
          <p class="ds-small mt-2">See the fleet run on your own documents.</p>
        </div>
        <div class="flex gap-3">
          <Button href={u('contact')}>Book a demo</Button>
          <Button href={u('pricing')} variant="ghost">
            See pricing
          </Button>
        </div>
      </div>
    </section>
  </main>
  <Footer />
</Base>

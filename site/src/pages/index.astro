---
import Base from '../layouts/Base.astro';
import TopNav from '../components/TopNav.astro';
import Footer from '../components/Footer.astro';
import Button from '../components/Button.astro';
import ConsoleHero from '../components/ConsoleHero.astro';
import AgentCard from '../components/AgentCard.astro';
import { Icon } from 'astro-icon/components';

const base = import.meta.env.BASE_URL;
const u = (p = '') => (base + p).replace(/\/{2,}/g, '/');

const fleet = [
  { icon: 'lucide:inbox', name: 'Intake', title: 'Triage and queue', body: 'Classify every inbound document by form and entity, route it to the right agent, and build the queue.', tools: ['classify', 'route'] },
  { icon: 'lucide:scan-line', name: 'Extraction', title: 'Fields with proof', body: 'Pull every field with a confidence score and a citation back to the source page. Low-confidence cells route to review.', tools: ['doc-extract', 'confidence'] },
  { icon: 'lucide:search', name: 'Research', title: 'Citation-backed answers', body: 'Tax questions answered by retrieval over a living knowledge base. Sources, not guesses.', tools: ['kb-search'] },
  { icon: 'lucide:file-stack', name: 'Workpaper', title: 'Reviewer-ready output', body: 'Assemble lead schedules and tie-outs where every number traces back to a source.', tools: ['assemble', 'cite'] },
  { icon: 'lucide:calendar-clock', name: 'Compliance', title: 'Deadlines and follow-up', body: 'Track deadlines across entities. Taxline drafts the follow-up; you send it.', tools: ['calendar', 'notify'] },
];

const steps = [
  { n: '01', icon: 'lucide:inbox', t: 'Intake', d: 'Drop documents. The fleet classifies and queues them.' },
  { n: '02', icon: 'lucide:scan-line', t: 'Extract', d: 'Every field scored and cited. Nothing assumed.' },
  { n: '03', icon: 'lucide:search', t: 'Research', d: 'Questions answered from primary sources.' },
  { n: '04', icon: 'lucide:file-stack', t: 'Assemble', d: 'Reviewer-ready workpapers, sourced end to end.' },
  { n: '05', icon: 'lucide:user-check', t: 'Review', d: 'You approve. Nothing ships unreviewed.' },
];
---

<Base>
  <TopNav />
  <main>
    <!-- Hero -->
    <section class="relative overflow-hidden border-b border-border">
      <div class="pointer-events-none absolute inset-0 console-grid opacity-70"></div>
      <div class="relative mx-auto max-w-[1200px] px-5 pb-16 pt-20 sm:px-6">
        <p class="ds-eyebrow reveal">Agentic tax operations</p>
        <h1 class="ds-display reveal mt-4 max-w-3xl" style="animation-delay:.05s">
          Remove manual tax operations.<br class="hidden sm:block" /> Keep the human approval.
        </h1>
        <p class="ds-lead reveal mt-5 max-w-2xl" style="animation-delay:.1s">
          A fleet of specialized agents triages, extracts, researches, and assembles — with
          confidence scores and citations on every field. You review. Nothing ships unreviewed.
        </p>
        <div class="reveal mt-8 flex flex-wrap gap-3" style="animation-delay:.15s">
          <Button href={u('contact')}>Book a demo</Button>
          <Button href={u('docs')} variant="ghost">Read the docs</Button>
        </div>
        <div class="reveal mt-7 flex flex-wrap gap-x-7 gap-y-2" style="animation-delay:.2s">
          <span class="inline-flex items-center gap-2 text-sm text-fg-muted">
            <Icon name="lucide:shield-check" class="size-4 text-fg-faint" />SOC 2 · human-in-the-loop
          </span>
          <span class="inline-flex items-center gap-2 text-sm text-fg-muted">
            <Icon name="lucide:git-branch" class="size-4 text-fg-faint" />Orchestrated, not autonomous
          </span>
        </div>
        <div class="reveal mt-14" style="animation-delay:.25s">
          <ConsoleHero />
        </div>
      </div>
    </section>

    <!-- The fleet -->
    <section class="border-b border-border">
      <div class="mx-auto max-w-[1200px] px-5 py-20 sm:px-6">
        <p class="ds-eyebrow">The fleet</p>
        <h2 class="ds-h2 mt-3 max-w-2xl">Five agents. One orchestrator. Your approval.</h2>
        <p class="ds-lead mt-3 max-w-2xl">Each agent is a tool-using worker with a narrow job. The orchestrator routes work between them and hands cited output to review. Nothing is autonomous end to end.</p>
        <div class="mt-10 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
          {fleet.map((a) => <AgentCard {...a} href={u('agents')} />)}
          <a href={u('agents')} class="flex flex-col justify-between rounded-lg border border-dashed border-border bg-base p-5 transition-colors hover:border-border-strong">
            <span class="ds-eyebrow text-fg-faint">Orchestrator</span>
            <span class="mt-3 inline-flex items-center gap-1.5 text-sm font-medium text-accent">See how routing works <Icon name="lucide:arrow-right" class="size-4" /></span>
          </a>
        </div>
      </div>
    </section>

    <!-- How it works -->
    <section class="border-b border-border bg-panel/40">
      <div class="mx-auto max-w-[1200px] px-5 py-20 sm:px-6">
        <p class="ds-eyebrow">Intake to reviewer-ready</p>
        <h2 class="ds-h2 mt-3 max-w-2xl">From a dropped document to a workpaper you sign off on.</h2>
        <div class="mt-12 grid gap-px overflow-hidden rounded-lg border border-border bg-border sm:grid-cols-2 lg:grid-cols-5">
          {steps.map((s) => (
            <div class="flex flex-col gap-3 bg-base p-5">
              <div class="flex items-center justify-between">
                <Icon name={s.icon} class="size-5 text-accent" />
                <span class="font-mono text-[11px] tabular-nums text-fg-faint">{s.n}</span>
              </div>
              <div>
                <div class="text-[15px] font-semibold text-fg">{s.t}</div>
                <p class="mt-1 text-[13px] leading-relaxed text-fg-muted">{s.d}</p>
              </div>
            </div>
          ))}
        </div>
        <p class="mt-6 inline-flex items-center gap-2 font-mono text-xs text-fg-faint">
          <Icon name="lucide:user-check" class="size-4 text-accent" />A human approves before output ships — every time.
        </p>
      </div>
    </section>

    <!-- CTA -->
    <section class="border-b border-border">
      <div class="mx-auto flex max-w-[1200px] flex-col items-start justify-between gap-6 px-5 py-16 sm:flex-row sm:items-center sm:px-6">
        <div>
          <h2 class="ds-h2 max-w-xl">Reduce review drag. Ship reviewer-ready output.</h2>
          <p class="ds-small mt-2">See the fleet run on your own documents.</p>
        </div>
        <div class="flex gap-3">
          <Button href={u('contact')}>Book a demo</Button>
          <Button href={u('app')} variant="ghost">Open the app</Button>
        </div>
      </div>
    </section>
  </main>
  <Footer />
</Base>

---
import Base from '../layouts/Base.astro';
import Logo from '../components/Logo.astro';
import { Icon } from 'astro-icon/components';
import { u } from '../lib/url';


const nav = [
  {
    group: 'Get started',
    items: [
      { label: 'Overview', href: '#overview' },
      { label: 'Quickstart', href: '#quickstart' },
      { label: 'Architecture', href: '#architecture' },
    ],
  },
  {
    group: 'The fleet',
    items: [
      { label: 'Orchestrator', href: '#orchestrator' },
      { label: 'Intake', href: '#intake' },
      { label: 'Extraction', href: '#extraction' },
      { label: 'Research', href: '#research', active: true },
      { label: 'Workpaper', href: '#workpaper' },
      { label: 'Compliance', href: '#compliance' },
    ],
  },
  {
    group: 'Knowledge base',
    items: [
      { label: 'Manifest', href: '#manifest' },
      { label: 'Ingest & refresh', href: '#ingest' },
    ],
  },
];
---

<Base
  title="Research — Docs — Taxline"
  description="The Research agent answers tax questions with citations: retrieval over a living knowledge base, never freeform guessing. It runs behind the orchestrator and hands cited findings to Workpaper."
>
  <!-- Top doc bar -->
  <header class="sticky top-0 z-50 h-14 border-b border-border bg-base">
    <div class="flex h-14 items-center gap-4 px-5">
      <!-- Left: logo + docs badge -->
      <a href={u('')} class="flex shrink-0 items-center gap-2">
        <Logo size={26} />
        <span class="rounded-sm border border-border bg-raised px-1.5 py-0.5 font-mono text-[11px] text-fg-muted">docs</span>
      </a>

      <!-- Search (non-functional, decorative) -->
      <div class="ml-2 hidden min-w-0 flex-1 sm:flex">
        <div class="flex w-full max-w-xs items-center gap-2 rounded-md border border-border bg-raised px-3 py-1.5">
          <Icon name="lucide:search" class="size-3.5 shrink-0 text-fg-faint" />
          <span class="truncate text-[13px] text-fg-faint">Search docs…</span>
          <kbd class="ml-auto rounded-sm border border-border bg-base px-1.5 py-0.5 font-mono text-[10px] text-fg-faint">⌘K</kbd>
        </div>
      </div>

      <!-- Right: links -->
      <nav class="ml-auto flex shrink-0 items-center gap-5 text-[13px]">
        <a href={u('product')} class="text-fg-muted transition-colors hover:text-fg">Product</a>
        <a href="#" class="text-fg-muted transition-colors hover:text-fg">Changelog</a>
      </nav>
    </div>
  </header>

  <!-- Body -->
  <div class="flex">
    <!-- Left sidebar -->
    <aside class="sticky top-14 hidden h-[calc(100vh-3.5rem)] w-60 shrink-0 overflow-y-auto border-r border-border px-4 py-8 md:block">
      <nav class="space-y-7">
        {nav.map((section) => (
          <div>
            <p class="px-2 font-mono text-[11px] uppercase tracking-[0.14em] text-fg-faint">{section.group}</p>
            <ul class="mt-2 space-y-0.5">
              {section.items.map((item) => (
                <li>
                  <a
                    href={item.href}
                    aria-current={item.active ? 'page' : undefined}
                    class:list={[
                      'block rounded-md px-2 py-1.5 text-[13px] transition-colors',
                      item.active
                        ? 'bg-accent-soft text-fg'
                        : 'text-fg-muted hover:text-fg',
                    ]}
                  >
                    {item.label}
                  </a>
                </li>
              ))}
            </ul>
          </div>
        ))}
      </nav>
    </aside>

    <!-- Main content -->
    <main id="main" class="min-w-0 flex-1">
      <article class="mx-auto max-w-3xl px-8 py-10">
        <!-- Breadcrumb -->
        <p class="font-mono text-[12px] text-fg-faint">The fleet / Research</p>

        <h1 class="ds-h1 mt-3">Research</h1>

        <p class="ds-lead mt-4">
          The Research agent answers tax questions with citations — retrieval over a living
          knowledge base, never freeform guessing. It runs behind the orchestrator and hands
          cited findings to Workpaper.
        </p>

        <h2 class="ds-h2 mt-12">The pattern</h2>
        <p class="ds-body mt-4 text-fg-muted">
          Each agent is a tool-using worker with a narrow job. The orchestrator routes a request
          to the agent best suited to it, collects the output, and passes control on. Nothing is
          autonomous end to end — a human approves before output ships.
        </p>

        <!-- Code block -->
        <div class="mt-6 overflow-hidden rounded-md border border-border">
          <div class="flex items-center justify-between border-b border-border bg-panel px-3 py-1.5">
            <span class="font-mono text-[11px] text-fg-muted">service/agents/research.ts</span>
            <button type="button" aria-label="Copy code" class="text-fg-faint transition-colors hover:text-fg">
              <Icon name="lucide:copy" class="size-3.5" />
            </button>
          </div>
          <pre class="overflow-x-auto bg-inset p-4 font-mono text-[12px] leading-relaxed text-fg"><code>export const research = defineAgent(&#123;
  name: <span class="text-ok-bright">'research'</span>,
  instructions: <span class="text-ok-bright">'Answer with citations from the knowledge base. Never guess.'</span>,
  tools: [kbSearch],            <span class="text-fg-faint">// retrieval over knowledge-base/</span>
  handoff: <span class="text-ok-bright">'workpaper'</span>,
&#125;);</code></pre>
        </div>

        <!-- Next -->
        <div class="mt-10 border-t border-border pt-6">
          <a href="#workpaper" class="inline-flex items-center gap-1.5 text-[14px] font-medium text-accent transition-colors hover:text-accent-hover">
            Next: Workpaper
            <Icon name="lucide:arrow-right" class="size-4" />
          </a>
        </div>
      </article>
    </main>
  </div>
</Base>

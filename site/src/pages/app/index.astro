---
import AppShell from '../../components/app/AppShell.astro';
import StatusPill from '../../components/StatusPill.astro';
import { Icon } from 'astro-icon/components';
import { docs } from '../../lib/data/app';

const base = import.meta.env.BASE_URL;
const u = (p = '') => (base + p).replace(/\/{2,}/g, '/');
const needsReview = docs.filter((d) => d.status === 'review').length;
const approved = docs.filter((d) => d.status === 'approved').length;
const confColor = (c: number | null) =>
  c == null ? 'text-fg-faint' : c >= 0.85 ? 'text-ok-bright' : c >= 0.6 ? 'text-warn-bright' : 'text-danger-bright';
---

<AppShell title="Intake queue" active="app">
  <div class="p-6">
    <div class="flex flex-wrap items-center gap-3">
      <div class="flex items-center gap-1 rounded-md border border-border bg-panel p-1">
        <button type="button" data-tab="all" class="tab rounded-sm px-3 py-1.5 text-[13px] font-medium">All <span class="font-mono text-fg-faint">{docs.length}</span></button>
        <button type="button" data-tab="review" class="tab rounded-sm px-3 py-1.5 text-[13px] font-medium">Needs review <span class="font-mono text-fg-faint">{needsReview}</span></button>
        <button type="button" data-tab="approved" class="tab rounded-sm px-3 py-1.5 text-[13px] font-medium">Approved <span class="font-mono text-fg-faint">{approved}</span></button>
      </div>
      <div class="ml-auto flex items-center gap-2">
        <button type="button" class="inline-flex items-center gap-2 rounded-md border border-border bg-panel px-3 py-1.5 text-[13px] text-fg-muted transition-colors hover:bg-raised"><Icon name="lucide:sliders-horizontal" class="size-4" />Filter</button>
        <button type="button" class="inline-flex items-center gap-2 rounded-md border border-border bg-panel px-3 py-1.5 text-[13px] text-fg-muted transition-colors hover:bg-raised"><Icon name="lucide:arrow-up-down" class="size-4" />Confidence</button>
      </div>
    </div>

    <div class="mt-5 overflow-x-auto rounded-lg border border-border">
      <table class="w-full min-w-[720px] border-collapse text-left">
        <thead>
          <tr class="border-b border-border bg-panel font-mono text-[11px] uppercase tracking-wider text-fg-faint">
            <th class="px-4 py-2.5 font-medium">Document</th>
            <th class="px-4 py-2.5 font-medium">Client</th>
            <th class="px-4 py-2.5 font-medium">Type</th>
            <th class="px-4 py-2.5 font-medium">Last agent</th>
            <th class="px-4 py-2.5 font-medium">Status</th>
            <th class="px-4 py-2.5 text-right font-medium">Confidence</th>
          </tr>
        </thead>
        <tbody>
          {docs.map((d) => (
            <tr data-status={d.status} class="row border-b border-border-faint bg-base transition-colors last:border-0 hover:bg-raised">
              <td class="px-4 py-3">
                <a href={u('app/' + d.id)} class="flex items-center gap-2.5">
                  <Icon name="lucide:file-text" class="size-4 shrink-0 text-fg-faint" />
                  <span class="font-mono text-[13px] text-fg">{d.name}</span>
                </a>
              </td>
              <td class="px-4 py-3 text-[13px] text-fg-muted">{d.client}</td>
              <td class="px-4 py-3"><span class="rounded-sm bg-raised px-2 py-0.5 font-mono text-[11px] text-fg-muted">{d.type}</span></td>
              <td class="px-4 py-3 text-[13px] text-fg-muted">{d.lastAgent}</td>
              <td class="px-4 py-3"><StatusPill status={d.status} /></td>
              <td class={`px-4 py-3 text-right font-mono text-[13px] tabular-nums ${confColor(d.confidence)}`}>{d.confidence == null ? '—' : d.confidence.toFixed(2)}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </div>

  <script>
    const tabs = Array.from(document.querySelectorAll<HTMLButtonElement>('.tab'));
    const rows = Array.from(document.querySelectorAll<HTMLTableRowElement>('tr.row'));
    function setTab(name: string) {
      for (const t of tabs) {
        const on = t.dataset.tab === name;
        t.classList.toggle('bg-raised', on);
        t.classList.toggle('text-fg', on);
        t.classList.toggle('text-fg-muted', !on);
      }
      for (const r of rows) {
        const s = r.getAttribute('data-status');
        const show = name === 'all' || s === name;
        r.style.display = show ? '' : 'none';
      }
    }
    tabs.forEach((t) => t.addEventListener('click', () => setTab(t.dataset.tab || 'all')));
    setTab('all');
  </script>
</AppShell>

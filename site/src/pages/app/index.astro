---
import AppShell from '../../components/app/AppShell.astro';
import StatusPill from '../../components/StatusPill.astro';
import { Icon } from 'astro-icon/components';
import { docs } from '../../lib/data/app';
import { u } from '../../lib/url';

const needsReview = docs.filter((d) => d.status === 'review').length;
const approved = docs.filter((d) => d.status === 'approved').length;
const confColor = (c: number | null) =>
  c == null ? 'text-fg-faint' : c >= 0.85 ? 'text-ok-bright' : c >= 0.6 ? 'text-warn-bright' : 'text-danger-bright';
---

<AppShell title="Intake queue" active="app">
  <div class="p-6">
    <div class="flex flex-wrap items-center gap-3">
      <div class="flex items-center gap-1 rounded-md border border-border bg-panel p-1">
        <button type="button" data-tab="all" class="tab rounded-sm px-3 py-1.5 text-[13px] font-medium">All <span class="font-mono text-fg-faint">{docs.length}</span></button>
        <button type="button" data-tab="review" class="tab rounded-sm px-3 py-1.5 text-[13px] font-medium">Needs review <span class="font-mono text-fg-faint">{needsReview}</span></button>
        <button type="button" data-tab="approved" class="tab rounded-sm px-3 py-1.5 text-[13px] font-medium">Approved <span class="font-mono text-fg-faint">{approved}</span></button>
      </div>
      <div class="ml-auto flex items-center gap-2">
        <button id="q-filter" type="button" class="inline-flex items-center gap-2 rounded-md border border-border bg-panel px-3 py-1.5 text-[13px] text-fg-muted transition-colors hover:bg-raised"><Icon name="lucide:sliders-horizontal" class="size-4" />Needs attention</button>
        <button id="q-sort" type="button" class="inline-flex items-center gap-2 rounded-md border border-border bg-panel px-3 py-1.5 text-[13px] text-fg-muted transition-colors hover:bg-raised"><Icon name="lucide:arrow-up-down" class="size-4" />Confidence <span data-caret class="font-mono text-fg-faint"></span></button>
      </div>
    </div>

    <div class="mt-5 overflow-x-auto rounded-lg border border-border">
      <table class="w-full min-w-[720px] border-collapse text-left">
        <thead>
          <tr class="border-b border-border bg-panel font-mono text-[11px] uppercase tracking-wider text-fg-faint">
            <th class="px-4 py-2.5 font-medium">Document</th>
            <th class="px-4 py-2.5 font-medium">Client</th>
            <th class="px-4 py-2.5 font-medium">Type</th>
            <th class="px-4 py-2.5 font-medium">Last agent</th>
            <th class="px-4 py-2.5 font-medium">Status</th>
            <th class="px-4 py-2.5 text-right font-medium">Confidence</th>
          </tr>
        </thead>
        <tbody>
          {docs.map((d) => (
            <tr data-status={d.status} data-conf={d.confidence == null ? '' : d.confidence} class="row border-b border-border-faint bg-base transition-colors last:border-0 hover:bg-raised">
              <td class="px-4 py-3">
                <a href={u('app/' + d.id)} class="flex items-center gap-2.5">
                  <Icon name="lucide:file-text" class="size-4 shrink-0 text-fg-faint" />
                  <span class="font-mono text-[13px] text-fg">{d.name}</span>
                </a>
              </td>
              <td class="px-4 py-3 text-[13px] text-fg-muted">{d.client}</td>
              <td class="px-4 py-3"><span class="rounded-sm bg-raised px-2 py-0.5 font-mono text-[11px] text-fg-muted">{d.type}</span></td>
              <td class="px-4 py-3 text-[13px] text-fg-muted">{d.lastAgent}</td>
              <td class="px-4 py-3"><StatusPill status={d.status} /></td>
              <td class={`px-4 py-3 text-right font-mono text-[13px] tabular-nums ${confColor(d.confidence)}`}>{d.confidence == null ? '—' : d.confidence.toFixed(2)}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </div>

  <script>
    const tabs = Array.from(document.querySelectorAll<HTMLButtonElement>('.tab'));
    const rows = Array.from(document.querySelectorAll<HTMLTableRowElement>('tr.row'));
    const tbody = rows[0]?.parentElement ?? null;
    const filterBtn = document.getElementById('q-filter');
    const sortBtn = document.getElementById('q-sort');

    let tab = 'all';
    let lowOnly = false;
    let sortDir: 'none' | 'desc' | 'asc' = 'none';

    const conf = (r: HTMLTableRowElement) => {
      const v = r.dataset.conf;
      return v === '' || v == null ? NaN : Number(v);
    };

    function apply() {
      for (const r of rows) {
        const s = r.getAttribute('data-status');
        const c = conf(r);
        const tabOk = tab === 'all' || s === tab;
        const lowOk = !lowOnly || Number.isNaN(c) || c < 0.85; // null/low = needs attention
        r.style.display = tabOk && lowOk ? '' : 'none';
      }
      if (sortDir !== 'none' && tbody) {
        const sorted = [...rows].sort((a, b) => {
          const ca = conf(a);
          const cb = conf(b);
          if (Number.isNaN(ca) && Number.isNaN(cb)) return 0;
          if (Number.isNaN(ca)) return 1; // unscored sinks to the bottom
          if (Number.isNaN(cb)) return -1;
          return sortDir === 'desc' ? cb - ca : ca - cb;
        });
        for (const r of sorted) tbody.appendChild(r);
      }
    }

    for (const t of tabs) {
      t.addEventListener('click', () => {
        tab = t.dataset.tab || 'all';
        for (const x of tabs) {
          const on = x.dataset.tab === tab;
          x.classList.toggle('bg-raised', on);
          x.classList.toggle('text-fg', on);
          x.classList.toggle('text-fg-muted', !on);
        }
        apply();
      });
    }

    filterBtn?.addEventListener('click', () => {
      lowOnly = !lowOnly;
      filterBtn.classList.toggle('border-accent-line', lowOnly);
      filterBtn.classList.toggle('text-fg', lowOnly);
      apply();
    });

    sortBtn?.addEventListener('click', () => {
      sortDir = sortDir === 'desc' ? 'asc' : 'desc';
      const caret = sortBtn.querySelector('[data-caret]');
      if (caret) caret.textContent = sortDir === 'desc' ? '↓' : '↑';
      apply();
    });

    tabs.find((t) => t.dataset.tab === 'all')?.classList.add('bg-raised', 'text-fg');
    apply();
  </script>
</AppShell>

{
  "name": "taxline",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "license": "UNLICENSED",
  "description": "Taxline — AI tax operations, from intake to reviewer-ready workpapers.",
  "workspaces": [
    "site"
  ],
  "scripts": {
    "dev": "npm run dev --workspace site",
    "dev:service": "npm --prefix service run dev",
    "build": "npm run build --workspace site",
    "preview": "npm run preview --workspace site",
    "check": "npm run check --workspace site",
    "typecheck": "npm run check && npm --prefix service run typecheck && npm --prefix workers/contact run typecheck",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "refresh-kb": "npm --prefix service run refresh-kb"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "eslint": "^9.17.0",
    "eslint-plugin-astro": "^1.3.1",
    "globals": "^15.14.0",
    "prettier": "^3.9.6",
    "prettier-plugin-astro": "^0.14.1",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.68.0"
  },
  "engines": {
    "node": ">=20"
  }
}

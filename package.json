{
  "name": "taxline",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "license": "UNLICENSED",
  "description": "Taxline \u2014 agentic tax operations: an AI agent fleet, a tested 2026 tax engine, free calculators, and human approval before anything ships.",
  "workspaces": [
    "site",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace site",
    "dev:service": "npm --prefix service run dev",
    "build": "npm run build --workspace site",
    "preview": "npm run preview --workspace site",
    "check": "npm run check --workspace site",
    "typecheck": "npm run check && npm --prefix packages/tax-engine run typecheck && npm --prefix service run typecheck && npm --prefix workers/contact run typecheck",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "refresh-kb": "npm --prefix service run refresh-kb",
    "test": "npm test --workspace @taxline/tax-engine",
    "pull-insights": "node scripts/pull-insights.mjs",
    "dev:cms": "npm --prefix cms run dev"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "eslint": "^10.5.0",
    "eslint-plugin-astro": "^1.3.1",
    "globals": "^15.14.0",
    "prettier": "^3.4.2",
    "prettier-plugin-astro": "^0.14.1",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.0"
  },
  "engines": {
    "node": ">=20"
  }
}

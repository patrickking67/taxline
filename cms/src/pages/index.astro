---
// The CMS serves editors and the export API only; the public site is static.
export const prerender = false;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <title>Taxline CMS</title>
    <style>
      body { margin: 0; min-height: 100vh; display: grid; place-items: center; background: #0e0f10; color: #ece8e0; font: 15px/1.6 ui-sans-serif, system-ui, sans-serif; }
      main { max-width: 34rem; padding: 2rem; }
      code { font-family: ui-monospace, monospace; color: #3da57b; }
      a { color: #3da57b; }
    </style>
  </head>
  <body>
    <main>
      <h1>Taxline CMS</h1>
      <p>EmDash editorial backend for Taxline Insights. Write and publish in the <a href="/_emdash/admin">admin</a>. The marketing site pulls published entries from <code>/api/insights.json</code> at build time.</p>
    </main>
  </body>
</html>

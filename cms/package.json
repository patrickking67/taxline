{
  "name": "@taxline/cms",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Taxline editorial CMS — EmDash on Astro. Editors write Insights here; the static site pulls published entries at build time.",
  "emdash": {
    "seed": "seed/seed.json"
  },
  "engines": {
    "node": ">=22.16"
  },
  "scripts": {
    "dev": "astro dev --port 4322",
    "build": "astro build",
    "start": "node ./dist/server/entry.mjs",
    "seed": "emdash seed seed/seed.json",
    "typecheck": "astro check"
  },
  "dependencies": {
    "@astrojs/node": "^11.1.5",
    "@astrojs/react": "^7.0.0",
    "astro": "^7.3.2",
    "emdash": "^1.3.0",
    "react": "19.2.4",
    "react-dom": "19.2.4"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "typescript": "^5.7.2"
  }
}

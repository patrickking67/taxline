    "insights": [
      {
        "id": "2026-federal-tax-brackets",
        "slug": "2026-federal-tax-brackets",
        "status": "published",
        "data": {
          "title": "2026 federal tax brackets and standard deduction, line by line",
          "excerpt": "The seven 2026 rates, every threshold for every filing status, and the new standard deduction, transcribed from Rev. Proc. 2025-32 and checked against the IRS base amounts.",
          "content": [
            {
              "_type": "block",
              "_key": "k0",
              "style": "normal",
              "markDefs": [],
              "children": [
                {
                  "_type": "span",
                  "_key": "k1",
                  "text": "The IRS published the tax-year 2026 inflation adjustments in ",
                  "marks": []
                },
                {
                  "_type": "span",
                  "_key": "k2",
                  "text": "Rev. Proc. 2025-32",
                  "marks": [
                    "strong"
                  ]
                },
                {
                  "_type": "span",
                  "_key": "k3",
                  "text": ", which also reflects the One Big Beautiful Bill Act. These figures apply to returns filed in 2027.",
                  "marks": []
                }
              ]
            },
            {
              "_type": "block",
              "_key": "k4",
              "style": "h2",
              "markDefs": [],
              "children": [
                {
                  "_type": "span",
                  "_key": "k5",
                  "text": "The seven rates",
                  "marks": []
                }
              ]
            },
            {
              "_type": "block",
              "_key": "k6",
              "style": "normal",
              "markDefs": [],
              "children": [
                {
                  "_type": "span",
                  "_key": "k7",
                  "text": "The structure is unchanged: 10%, 12%, 22%, 24%, 32%, 35%, and 37%. What moves is where each band starts.",
                  "marks": []
                }
              ]
            },
            {
              "_type": "block",
              "_key": "k8",
              "style": "normal",
              "listItem": "bullet",
              "level": 1,
              "markDefs": [],
              "children": [
                {
                  "_type": "span",
                  "_key": "k9",
                  "text": "Single: 12% above $12,400 · 22% above $50,400 · 24% above $105,700 · 32% above $201,775 · 35% above $256,225 · 37% above $640,600",
                  "marks": []
                }
              ]
            },
            {
              "_type": "block",
              "_key": "k10",
              "style": "normal",
              "listItem": "bullet",
              "level": 1,
              "markDefs": [],
              "children": [
                {
                  "_type": "span",
                  "_key": "k11",
                  "text": "Married filing jointly: 12% above $24,800 · 22% above $100,800 · 24% above $211,400 · 32% above $403,550 · 35% above $512,450 · 37% above $768,700",
                  "marks": []
                }
              ]
            },
            {
              "_type": "block",
              "_key": "k12",
              "style": "normal",
              "listItem": "bullet",
              "level": 1,
              "markDefs": [],
              "children": [
                {
                  "_type": "span",
                  "_key": "k13",
                  "text": "Head of household: 12% above $17,700 · 22% above $67,450 · 24% above $105,700 · 32% above $201,750 · 35% above $256,200 · 37% above $640,600",
                  "marks": []
                }
              ]
            },
            {
              "_type": "block",
              "_key": "k14",
              "style": "normal",
              "listItem": "bullet",
              "level": 1,
              "markDefs": [],
              "children": [
                {
                  "_type": "span",
                  "_key": "k15",
                  "text": "Married filing separately: the single bands, except 37% starts above $384,350",
                  "marks": []
                }
              ]
            },
            {
              "_type": "block",
              "_key": "k16",
              "style": "h2",
              "markDefs": [],
              "children": [
                {
                  "_type": "span",
                  "_key": "k17",
                  "text": "Standard deduction",
                  "marks": []
                }
              ]
            },
            {
              "_type": "block",
              "_key": "k18",
              "style": "normal",
              "markDefs": [],
              "children": [
                {
                  "_type": "span",
                  "_key": "k19",
                  "text": "$16,100",
                  "marks": [
                    "strong"
                  ]
                },
                {
                  "_type": "span",
                  "_key": "k20",
                  "text": " single or married filing separately, ",
                  "marks": []
                },
                {
                  "_type": "span",
                  "_key": "k21",
                  "text": "$32,200",
                  "marks": [
                    "strong"
                  ]
                },
                {
                  "_type": "span",
                  "_key": "k22",
                  "text": " married filing jointly, and ",
                  "marks": []
                },
                {
                  "_type": "span",
                  "_key": "k23",
                  "text": "$24,150",
                  "marks": [
                    "strong"
                  ]
                },
                {
                  "_type": "span",
                  "_key": "k24",
                  "text": " head of household.",
                  "marks": []
                }
              ]
            },
            {
              "_type": "block",
              "_key": "k25",
              "style": "h2",
              "markDefs": [],
              "children": [
                {
                  "_type": "span",
                  "_key": "k26",
                  "text": "How we verify a table",
                  "marks": []
                }
              ]
            },
            {
              "_type": "block",
              "_key": "k27",
              "style": "normal",
              "markDefs": [],
              "children": [
                {
                  "_type": "span",
                  "_key": "k28",
                  "text": "A bracket table can be checked against itself. The IRS publishes each band as \"base plus rate on the excess\", and every base must equal the tax on all the bands below it. For single filers that gives $1,240, $5,800, $17,966, $41,024, $58,448, and $192,979.25, exactly what the Rev. Proc. prints. The Taxline engine's test suite asserts this for every filing status, so a transcription error fails the build.",
                  "marks": []
                }
              ]
            },
            {
              "_type": "block",
              "_key": "k29",
              "style": "h2",
              "markDefs": [],
              "children": [
                {
                  "_type": "span",
                  "_key": "k30",
                  "text": "Marginal is not effective",
                  "marks": []
                }
              ]
            },
            {
              "_type": "block",
              "_key": "k31",
              "style": "normal",
              "markDefs": [],
              "children": [
                {
                  "_type": "span",
                  "_key": "k32",
                  "text": "A filer at $100,000 of taxable income is in the 22% bracket but pays $16,712, an effective 16.7%. The income tax calculator plots both and marks where you sit on the curve.",
                  "marks": []
                }
              ]
            }
          ],
          "tool": "income-tax",
          "reading_minutes": 5
        },
        "taxonomies": {
          "category": [
            "tax-year-2026"
          ]
        }
      },
      {
        "id": "estimated-tax-safe-harbor",
        "slug": "estimated-tax-safe-harbor",
        "status": "published",
        "data": {
          "title": "The estimated tax safe harbor, with the math",
          "excerpt": "Pay the smaller of 90% of this year's tax or 100% of last year's (110% above $150,000 of AGI), and the underpayment penalty does not apply. Here is how to compute it and when to pay.",
          "content": [
            {
              "_type": "block",
              "_key": "k33",
              "style": "normal",
              "markDefs": [],
              "children": [
                {
                  "_type": "span",
                  "_key": "k34",
                  "text": "Withholding covers most W-2 earners. Freelancers, business owners, and investors usually need ",
                  "marks": []
                },
                {
                  "_type": "span",
                  "_key": "k35",
                  "text": "quarterly estimates",
                  "marks": [
                    "strong"
                  ]
                },
                {
                  "_type": "span",
                  "_key": "k36",
                  "text": ", and the cheapest way to avoid the underpayment penalty is to hit the safe harbor in IRC §6654(d).",
                  "marks": []
                }
              ]
            },
            {
              "_type": "block",
              "_key": "k37",
              "style": "h2",
              "markDefs": [],
              "children": [
                {
                  "_type": "span",
                  "_key": "k38",
                  "text": "The rule",
                  "marks": []
                }
              ]
            },
            {
              "_type": "block",
              "_key": "k39",
              "style": "normal",
              "markDefs": [],
              "children": [
                {
                  "_type": "span",
                  "_key": "k40",
                  "text": "Required annual payment = the smaller of ",
                  "marks": []
                },
                {
                  "_type": "span",
                  "_key": "k41",
                  "text": "90% of this year's tax",
                  "marks": [
                    "strong"
                  ]
                },
                {
                  "_type": "span",
                  "_key": "k42",
                  "text": " or ",
                  "marks": []
                },
                {
                  "_type": "span",
                  "_key": "k43",
                  "text": "100% of last year's tax",
                  "marks": [
                    "strong"
                  ]
                },
                {
                  "_type": "span",
                  "_key": "k44",
                  "text": ". If last year's AGI was over $150,000 ($75,000 married filing separately), the prior-year test is ",
                  "marks": []
                },
                {
                  "_type": "span",
                  "_key": "k45",
                  "text": "110%",
                  "marks": [
                    "strong"
                  ]
                },
                {
                  "_type": "span",
                  "_key": "k46",
                  "text": ".",
                  "marks": []
                }
              ]
            },
            {
              "_type": "block",
              "_key": "k47",
              "style": "h2",
              "markDefs": [],
              "children": [
                {
                  "_type": "span",
                  "_key": "k48",
                  "text": "A worked example",
                  "marks": []
                }
              ]
            },
            {
              "_type": "block",
              "_key": "k49",
              "style": "normal",
              "markDefs": [],
              "children": [
                {
                  "_type": "span",
                  "_key": "k50",
                  "text": "Expected 2026 tax is $32,000 and withholding will be $6,000. Last year's tax was $26,000 on $165,000 of AGI.",
                  "marks": []
                }
              ]
            },
            {
              "_type": "block",
              "_key": "k51",
              "style": "normal",
              "listItem": "bullet",
              "level": 1,
              "markDefs": [],
              "children": [
                {
                  "_type": "span",
                  "_key": "k52",
                  "text": "90% of this year: $28,800",
                  "marks": []
                }
              ]
            },
            {
              "_type": "block",
              "_key": "k53",
              "style": "normal",
              "listItem": "bullet",
              "level": 1,
              "markDefs": [],
              "children": [
                {
                  "_type": "span",
                  "_key": "k54",
                  "text": "110% of last year: $28,600",
                  "marks": []
                }
              ]
            },
            {
              "_type": "block",
              "_key": "k55",
              "style": "normal",
              "listItem": "bullet",
              "level": 1,
              "markDefs": [],
              "children": [
                {
                  "_type": "span",
                  "_key": "k56",
                  "text": "Safe harbor: $28,600, less $6,000 withholding = ",
                  "marks": []
                },
                {
                  "_type": "span",
                  "_key": "k57",
                  "text": "$22,600",
                  "marks": [
                    "strong"
                  ]
                },
                {
                  "_type": "span",
                  "_key": "k58",
                  "text": " through estimates, or $5,650 per installment",
                  "marks": []
                }
              ]
            },
            {
              "_type": "block",
              "_key": "k59",
              "style": "h2",
              "markDefs": [],
              "children": [
                {
                  "_type": "span",
                  "_key": "k60",
                  "text": "The 2026 due dates",
                  "marks": []
                }
              ]
            },
            {
              "_type": "block",
              "_key": "k61",
              "style": "normal",
              "markDefs": [],
              "children": [
                {
                  "_type": "span",
                  "_key": "k62",
                  "text": "April 15, 2026 · June 15, 2026 · September 15, 2026 · January 15, 2027.",
                  "marks": []
                }
              ]
            },
            {
              "_type": "block",
              "_key": "k63",
              "style": "h2",
              "markDefs": [],
              "children": [
                {
                  "_type": "span",
                  "_key": "k64",
                  "text": "Two details that matter",
                  "marks": []
                }
              ]
            },
            {
              "_type": "block",
              "_key": "k65",
              "style": "normal",
              "listItem": "bullet",
              "level": 1,
              "markDefs": [],
              "children": [
                {
                  "_type": "span",
                  "_key": "k66",
                  "text": "No estimates are required when this year's tax after withholding is under $1,000.",
                  "marks": []
                }
              ]
            },
            {
              "_type": "block",
              "_key": "k67",
              "style": "normal",
              "listItem": "bullet",
              "level": 1,
              "markDefs": [],
              "children": [
                {
                  "_type": "span",
                  "_key": "k68",
                  "text": "Withholding counts as paid evenly through the year, so extra withholding in December can cover an earlier shortfall. An estimate counts only from the day it is paid.",
                  "marks": []
                }
              ]
            }
          ],
          "tool": "estimated-tax",
          "reading_minutes": 4
        },
        "taxonomies": {
          "category": [
            "planning"
          ]
        }
      },
      {
        "id": "s-corp-election-worked-example",
        "slug": "s-corp-election-worked-example",
        "status": "published",
        "data": {
          "title": "When an S corporation election pays: a worked example at $150,000",
          "excerpt": "At $150,000 of profit and a $60,000 salary, the election saves a single filer $7,275.61 in 2026. The reasonable-compensation rule is why the salary is not zero.",
          "content": [
            {
              "_type": "block",
              "_key": "k69",
              "style": "normal",
              "markDefs": [],
              "children": [
                {
                  "_type": "span",
                  "_key": "k70",
                  "text": "A sole proprietor pays self-employment tax on 92.35% of profit. An S corporation owner pays FICA only on salary; the rest arrives on a K-1 with no self-employment tax. That is the whole saving, and also the whole risk.",
                  "marks": []
                }
              ]
            },
            {
              "_type": "block",
              "_key": "k71",
              "style": "h2",
              "markDefs": [],
              "children": [
                {
                  "_type": "span",
                  "_key": "k72",
                  "text": "The numbers",
                  "marks": []
                }
              ]
            },
            {
              "_type": "block",
              "_key": "k73",
              "style": "normal",
              "markDefs": [],
              "children": [
                {
                  "_type": "span",
                  "_key": "k74",
                  "text": "Single filer, $150,000 of profit, $60,000 salary, $2,000 a year of payroll and entity overhead, tax year 2026:",
                  "marks": []
                }
              ]
            },
            {
              "_type": "block",
              "_key": "k75",
              "style": "normal",
              "listItem": "bullet",
              "level": 1,
              "markDefs": [],
              "children": [
                {
                  "_type": "span",
                  "_key": "k76",
                  "text": "Sole prop: self-employment tax $21,194.33 plus income tax $16,410 = ",
                  "marks": []
                },
                {
                  "_type": "span",
                  "_key": "k77",
                  "text": "$37,604.33",
                  "marks": [
                    "strong"
                  ]
                }
              ]
            },
            {
              "_type": "block",
              "_key": "k78",
              "style": "normal",
              "listItem": "bullet",
              "level": 1,
              "markDefs": [],
              "children": [
                {
                  "_type": "span",
                  "_key": "k79",
                  "text": "S corp: income tax $19,148.72, employee and employer FICA $9,180, overhead $2,000 = ",
                  "marks": []
                },
                {
                  "_type": "span",
                  "_key": "k80",
                  "text": "$30,328.72",
                  "marks": [
                    "strong"
                  ]
                }
              ]
            },
            {
              "_type": "block",
              "_key": "k81",
              "style": "normal",
              "listItem": "bullet",
              "level": 1,
              "markDefs": [],
              "children": [
                {
                  "_type": "span",
                  "_key": "k82",
                  "text": "Difference: ",
                  "marks": []
                },
                {
                  "_type": "span",
                  "_key": "k83",
                  "text": "$7,275.61",
                  "marks": [
                    "strong"
                  ]
                },
                {
                  "_type": "span",
                  "_key": "k84",
                  "text": " a year",
                  "marks": []
                }
              ]
            },
            {
              "_type": "block",
              "_key": "k85",
              "style": "h2",
              "markDefs": [],
              "children": [
                {
                  "_type": "span",
                  "_key": "k86",
                  "text": "What moves the answer",
                  "marks": []
                }
              ]
            },
            {
              "_type": "block",
              "_key": "k87",
              "style": "normal",
              "listItem": "bullet",
              "level": 1,
              "markDefs": [],
              "children": [
                {
                  "_type": "span",
                  "_key": "k88",
                  "text": "QBI.",
                  "marks": [
                    "strong"
                  ]
                },
                {
                  "_type": "span",
                  "_key": "k89",
                  "text": " The K-1 is qualified business income, but salary is not, so the §199A deduction shrinks as salary grows.",
                  "marks": []
                }
              ]
            },
            {
              "_type": "block",
              "_key": "k90",
              "style": "normal",
              "listItem": "bullet",
              "level": 1,
              "markDefs": [],
              "children": [
                {
                  "_type": "span",
                  "_key": "k91",
                  "text": "The wage base.",
                  "marks": [
                    "strong"
                  ]
                },
                {
                  "_type": "span",
                  "_key": "k92",
                  "text": " Social Security stops at $184,500 of wages in 2026; above it the gap narrows.",
                  "marks": []
                }
              ]
            },
            {
              "_type": "block",
              "_key": "k93",
              "style": "normal",
              "listItem": "bullet",
              "level": 1,
              "markDefs": [],
              "children": [
                {
                  "_type": "span",
                  "_key": "k94",
                  "text": "Overhead.",
                  "marks": [
                    "strong"
                  ]
                },
                {
                  "_type": "span",
                  "_key": "k95",
                  "text": " Payroll service, a second return, and state entity fees are real costs; a few thousand dollars erases the benefit at lower profit.",
                  "marks": []
                }
              ]
            },
            {
              "_type": "block",
              "_key": "k96",
              "style": "h2",
              "markDefs": [],
              "children": [
                {
                  "_type": "span",
                  "_key": "k97",
                  "text": "Reasonable compensation",
                  "marks": []
                }
              ]
            },
            {
              "_type": "block",
              "_key": "k98",
              "style": "normal",
              "markDefs": [],
              "children": [
                {
                  "_type": "span",
                  "_key": "k99",
                  "text": "The IRS requires an S corporation to pay its working owner reasonable compensation for the services performed. A salary chosen to minimize tax rather than to reflect the work invites reclassification of distributions as wages, with back taxes and penalties. The calculator sweeps salary so you can see the trade-off; it does not pick a salary for you.",
                  "marks": []
                }
              ]
            }
          ],
          "tool": "s-corp",
          "reading_minutes": 6
        },
        "taxonomies": {
          "category": [
            "planning"
          ]
        }
      },
      {
        "id": "why-agents-never-do-arithmetic",
        "slug": "why-agents-never-do-arithmetic",
        "status": "published",
        "data": {
          "title": "Why our agents never do arithmetic",
          "excerpt": "Language models draft and extract. A tested engine computes. A person approves. How Taxline splits the work, and the checks that sit at each boundary.",
          "content": [
            {
              "_type": "block",
              "_key": "k100",
              "style": "normal",
              "markDefs": [],
              "children": [
                {
                  "_type": "span",
                  "_key": "k101",
                  "text": "Tax work has two kinds of steps: reading and judging, and computing. Models are strong at the first. They are the wrong tool for the second, because a number that is almost right is wrong.",
                  "marks": []
                }
              ]
            },
            {
              "_type": "block",
              "_key": "k102",
              "style": "h2",
              "markDefs": [],
              "children": [
                {
                  "_type": "span",
                  "_key": "k103",
                  "text": "Three boundaries",
                  "marks": []
                }
              ]
            },
            {
              "_type": "block",
              "_key": "k104",
              "style": "normal",
              "listItem": "bullet",
              "level": 1,
              "markDefs": [],
              "children": [
                {
                  "_type": "span",
                  "_key": "k105",
                  "text": "Models draft.",
                  "marks": [
                    "strong"
                  ]
                },
                {
                  "_type": "span",
                  "_key": "k106",
                  "text": " Extraction and research agents read documents and sources, and return null rather than guess. Every field carries a confidence and a citation.",
                  "marks": []
                }
              ]
            },
            {
              "_type": "block",
              "_key": "k107",
              "style": "normal",
              "listItem": "bullet",
              "level": 1,
              "markDefs": [],
              "children": [
                {
                  "_type": "span",
                  "_key": "k108",
                  "text": "Code computes.",
                  "marks": [
                    "strong"
                  ]
                },
                {
                  "_type": "span",
                  "_key": "k109",
                  "text": " The Workpaper agent calls compute_tax, a deterministic engine with 2026 figures from Rev. Proc. 2025-32. It quotes the engine's trace (operands, form line, authority) and never recomputes it.",

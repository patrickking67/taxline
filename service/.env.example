# Taxline service configuration.
# Copy to `.env` and fill in your key. NEVER commit a real key — `.env` is gitignored.

# Anthropic API key (required to actually run agents). Read at runtime via dotenv.
ANTHROPIC_API_KEY=

# HTTP port for the node:http server.
PORT=8787

# Model lineup — exact IDs. Default = accuracy; fast = classify/triage.
MODEL_DEFAULT=claude-opus-4-8
MODEL_FAST=claude-haiku-4-5

# Origin allowed for CORS (the static site's dev server). Comma-separate for several.
SITE_ORIGIN=http://localhost:4321

# Vector memory embeddings provider: local | voyage | openai.
#   local  = deterministic, offline, dependency-free (default; lexical, no real semantics)
#   voyage = Voyage AI (model voyage-3)              — set VOYAGE_API_KEY
#   openai = OpenAI (model text-embedding-3-small)   — set OPENAI_API_KEY
# After switching providers, rebuild the index: POST /memory/index.
EMBEDDINGS_PROVIDER=local

# Embeddings API keys — only the one matching EMBEDDINGS_PROVIDER is used.
VOYAGE_API_KEY=
OPENAI_API_KEY=

# Taxline service configuration.
# Copy to `.env` and fill in your key. NEVER commit a real key — `.env` is gitignored.

# Anthropic API key (required to actually run agents). Read at runtime via dotenv.
ANTHROPIC_API_KEY=

# HTTP port for the node:http server.
PORT=8787

# Model lineup — exact IDs. Default = accuracy; fast = classify/triage.
MODEL_DEFAULT=claude-opus-4-8
MODEL_FAST=claude-haiku-4-5

# Origin allowed for CORS (the static site's dev server). Comma-separate for several.
SITE_ORIGIN=http://localhost:4321
